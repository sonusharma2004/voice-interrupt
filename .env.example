# Copy to .env in this directory (project root).
# Groq is enough to run the demo (STT + LLM). TTS uses the browser by default.

GROQ_API_KEY=
GROQ_LLM_MODEL=qwen/qwen3.6-27b
GROQ_LLM_FALLBACK=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AvaNeural

# Optional — only if you add OpenAI credits later
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
